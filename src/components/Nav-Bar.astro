---
/**
 * Navbar – Mira
 * Fixed + transparent over hero
 */
---

<header class="absolute inset-x-0 top-0 z-50">
  <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-6">
    
    <!-- LOGO -->
    <a href="/" class="flex items-center gap-2">
      <img
        src="/assets/images/logo.png"
        alt="Mira"
        class="h-10 w-auto"
      />
    </a>

    <!-- DESKTOP NAV -->
    <ul class="hidden items-center gap-10 text-sm text-[#5c6442] md:flex">
      <li>
        <a href="/" class="transition hover:opacity-70">
          Home
        </a>
      </li>
      <li>
        <a href="/about" class="transition hover:opacity-70">
          About Us
        </a>
      </li>
      <li>
        <a
          href="/contact"
          class="rounded border border-[#c8b89a] px-5 py-2 transition hover:bg-[#5c6442] hover:text-white"
        >
          Contact Us
        </a>
      </li>
    </ul>

    <!-- MOBILE PLACEHOLDER -->
    <button
      class="md:hidden"
      aria-label="Open menu"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="#5c6442"
        class="h-6 w-6"
      >
        <path stroke-linecap="round" stroke-linejoin="round"
          d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
      </svg>
    </button>

  </nav>
</header>
