---
const { message } = Astro.props;
---

<div
  id="site-notice"
  class="fixed inset-x-0 bottom-0 z-50 bg-[#5c6442] px-6 py-4 text-[#f4efe4]"
>
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-6">
    <p class="text-sm">
      {message}
    </p>

    <button
      onclick="document.getElementById('site-notice')?.remove()"
      aria-label="Close notice"
      class="text-[#f4efe4] hover:opacity-70"
    >
      ✕
    </button>
  </div>
</div>

