---
import { Phone, Mail, MapPin } from "lucide-astro";
---

<section class="relative bg-white py-24 overflow-hidden">
  <!-- Decorative corner elements -->
  <div
    class="pointer-events-none absolute -top-20 -left-20 h-72 w-72 rounded-full border border-[#e6e1d6]"
  >
  </div>
  <div
    class="pointer-events-none absolute -bottom-24 -right-24 h-72 w-72 rounded-full border border-[#e6e1d6]"
  >
  </div>

  <div class="mx-auto max-w-7xl px-6">
    <!-- HEADER -->
    <div class="mx-auto max-w-xl text-center">
      <h2 class="font-serif text-3xl tracking-wide text-[#5c6442] md:text-4xl">
        FIND US AROUND THE WORLD
      </h2>

      <p class="mt-4 text-sm text-[#7a7a6a]">
        We are around the world to help you. Reach out to us at any of our
        global offices.
      </p>
    </div>

    <!-- CARDS -->
    <div class="mt-20 grid grid-cols-1 gap-10 md:grid-cols-3">
      <!-- CARD 1 -->
      <div class="bg-[#f4efe4] p-10 text-start flex flex-col align-center">
        <div class="flex align-center">
          <div class="mb-6 text-[#5c6442]">
            <Phone class="m-3" />
          </div>
          <div>
            <p class="text-sm uppercase font-bold tracking-wide text-[#5c6442]">
              Call Us:
            </p>
            <p class="mt-1 text-sm text-[#7a7a6a]">+852 2632 9288</p>
          </div>
        </div>
        <div class="mt-4">
          <div class="flex align-center">
            <div class="mb-6 text-[#5c6442]">
              <MapPin class="m-3" />
            </div>
            <div>
              <p class="font-serif text-lg text-[#5c6442]">Hong Kong</p>
              <p class="mt-2 text-xs leading-relaxed text-[#7a7a6a]">
                MIRA BOITE INTERNATIONAL LIMITED<br />
                Unit 1603, 16th Floor, The L. Plaza<br />
                367–375 Queen’s Road Central<br />
                Sheung Wan, Hong Kong
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- CARD 2 -->

      <div class="bg-[#f4efe4] p-10 text-start flex flex-col align-center">
        <div class="flex align-center">
          <div class="mb-6 text-[#5c6442]">
            <Phone class="m-3" />
          </div>
          <div>
            <p class="text-sm uppercase font-bold tracking-wide text-[#5c6442]">
              Call Us:
            </p>
            <p class="mt-1 text-sm text-[#7a7a6a]">+91 8111 851 888</p>
          </div>
        </div>
        <div class="mt-4">
          <div class="flex align-center">
            <div class="mb-6 text-[#5c6442]">
              <MapPin class="m-3" />
            </div>
            <div>
              <p class="font-serif text-lg text-[#5c6442]">India</p>
              <p class="mt-2 text-xs leading-relaxed text-[#7a7a6a]">
                Miraboite Packaging LLP<br />
                50/1062 A2, Prasanth Nagar Road<br />
                Perinad Edappally<br />
                Kerala, India – 682024
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- CARD 3 -->
<div class="bg-[#f4efe4] p-10 text-start flex flex-col align-center">
        <div class="flex align-center">
          <div class="mb-6 text-[#5c6442]">
            <Phone class="m-3" />
          </div>
          <div>
            <p class="text-sm uppercase font-bold tracking-wide text-[#5c6442]">
              Call Us:
            </p>
            <p class="mt-1 text-sm text-[#7a7a6a]">+971 6 7434804</p>
          </div>
        </div>
        <div class="mt-4">
          <div class="flex align-center">
            <div class="mb-6 text-[#5c6442]">
              <MapPin class="m-3" />
            </div>
            <div>
              <p class="font-serif text-lg text-[#5c6442]">United Arab Emirates</p>
              <p class="mt-2 text-xs leading-relaxed text-[#7a7a6a]">
                Diwaniya Interiors FZC<br />
                E32–F44, Hamriyah Free Zone<br />
                Sharjah, UAE<br />
                P.O. Box: 49944
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
