---
import {
  Phone,
  Mail,
  MapPin,
  Facebook,
  Instagram,
  Twitter,
  Linkedin,
} from "lucide-astro";
---

<footer class="bg-[#5c6442] text-[#f4efe4]">
  <div class="mx-auto max-w-7xl px-6 py-20">
    <!-- TOP GRID -->
    <div class="grid grid-cols-1 gap-12 md:grid-cols-3 items-start">
      <!-- BRAND -->
      <div>
        <img
          src="/assets/images/logo.png"
          alt="Mira Boite"
          class="h-10 w-auto"
        />

        <!-- SOCIALS -->
        <div class="mt-8 flex gap-4">
          <!-- Facebook -->
          <a
            href="#"
            class="flex h-10 w-10 items-center justify-center rounded-full bg-[#b5894d] text-white hover:opacity-80"
          >
            <Facebook class="h-4 w-4 stroke-[1.5]" />
          </a>

          <!-- Instagram -->
          <a
            href="#"
            class="flex h-10 w-10 items-center justify-center rounded-full bg-[#b5894d] text-white hover:opacity-80"
          >
            <Instagram class="h-4 w-4 stroke-[1.5]" />
          </a>

          <!-- Twitter -->
          <a
            href="#"
            class="flex h-10 w-10 items-center justify-center rounded-full bg-[#b5894d] text-white hover:opacity-80"
          >
            <Twitter class="h-4 w-4 stroke-[1.5]" />
          </a>

          <!-- LinkedIn -->
          <a
            href="#"
            class="flex h-10 w-10 items-center justify-center rounded-full bg-[#b5894d] text-white hover:opacity-80"
          >
            <Linkedin class="h-4 w-4 stroke-[1.5]" />
          </a>
        </div>
      </div>

      <!-- QUICK LINKS -->
      <div>
        <p class="font-serif text-lg mb-6">Quick Links:</p>

        <ul class="space-y-4 text-sm">
          <li class="flex items-center gap-2">
            <span>›</span>
            <a href="/contact" class="hover:underline"> Contact Us </a>
          </li>
          <li class="flex items-center gap-2">
            <span>›</span>
            <a href="/about" class="hover:underline"> About Us </a>
          </li>
        </ul>
      </div>

      <!-- CONTACT -->
      <div>
        <p class="font-serif text-lg mb-6">Contact us for Enquiry</p>

        <div class="flex items-center gap-3 text-sm">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            class="h-5 w-5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3 8l9 6 9-6M5 6h14a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2z"
            ></path>
          </svg>

          <a href="mailto:info@rashidmira.com" class="hover:underline">
            info@rashidmira.com
          </a>
        </div>
      </div>
    </div>

    <!-- COPYRIGHT -->
    <div class="mt-16 text-center text-xs text-[#e6e1d6]">
      Copyright © 2025 Mira Boite International Limited. All Rights Reserved.
    </div>
  </div>
</footer>
