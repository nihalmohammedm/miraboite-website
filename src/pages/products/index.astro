---
import Layout from "../../layouts/Layout.astro";
import NavBar from "../../components/Nav-Bar.astro";
import Footer from "../../components/footer.astro";
import { getPortfolioCollections } from "../../lib/portfolio";

const collections = getPortfolioCollections();
---

<Layout>
  <NavBar />

  <section class="bg-white pb-20 pt-36 md:pb-24 md:pt-40">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="font-serif text-3xl tracking-wide text-[#5c6442] md:text-5xl">
          Product Portfolio
        </h1>
        <p class="mt-4 text-sm leading-relaxed text-[#7a7a6a] md:text-base">
          Explore our signature jewelry packaging collections, curated to showcase our design language,
          structure options, and presentation quality.
        </p>
        <p class="mt-4 text-xs uppercase tracking-[0.18em] text-[#a88a59]">
          {collections.length} Collections · {collections.reduce((sum, item) => sum + item.imageCount, 0)} Images
        </p>
      </div>

      {
        collections.length === 0 ? (
          <div class="mx-auto mt-14 max-w-2xl border border-[#efe6d6] bg-[#faf8f2] p-8 text-center">
            <p class="font-serif text-xl text-[#5c6442]">No portfolio images found.</p>
            <p class="mt-2 text-sm text-[#7a7a6a]">
              Add folders with image files under <code>public/assets</code> and refresh.
            </p>
          </div>
        ) : (
          <div class="mt-16 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {collections.map((collection) => (
              <a
                href={`/products/${collection.slug}`}
                class="group block overflow-hidden border border-[#efe6d6] bg-white transition hover:-translate-y-1 hover:shadow-md"
              >
                <div class="h-64 w-full overflow-hidden">
                  <img
                    src={collection.coverImage}
                    alt={`${collection.title} cover image`}
                    loading="lazy"
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                </div>
                <div class="p-6">
                  <p class="font-serif text-xl text-[#5c6442]">{collection.title}</p>
                  <p class="mt-3 text-sm leading-relaxed text-[#7a7a6a]">{collection.description}</p>
                  <p class="mt-5 text-xs uppercase tracking-[0.18em] text-[#b5894d]">
                    {collection.imageCount} Images
                  </p>
                </div>
              </a>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <Footer />
</Layout>
