---
import Layout from "../../layouts/Layout.astro";

const woodenBoxes = [
  {
    name: "Classic Wooden Jewellery Box",
    image: "/assets/images/collection/wooden-box.png",
    href: "/products/wooden-box/classic",
  },
  {
    name: "Premium Lacquered Wooden Box",
    image: "/assets/images/collection/wooden-box-2.png",
    href: "/products/wooden-box/lacquered",
  },
  {
    name: "Velvet Lined Wooden Box",
    image: "/assets/images/collection/wooden-box-3.png",
    href: "/products/wooden-box/velvet-lined",
  },
  {
    name: "Custom Logo Wooden Box",
    image: "/assets/images/collection/wooden-box-4.png",
    href: "/products/wooden-box/custom-logo",
  },
];
---
<Layout>    

    <section class="bg-white py-20 md:py-24">
  <div class="mx-auto max-w-7xl px-6">

    <!-- PAGE HEADER -->
    <div class="mx-auto max-w-2xl text-center">
      <h1 class="font-serif text-3xl tracking-wide text-[#5c6442] md:text-4xl">
        Wooden Boxes
      </h1>

      <p class="mt-4 text-sm leading-relaxed text-[#7a7a6a]">
        Our wooden box collection is designed for premium jewellery presentation,
        offering durability, refined finishes, and complete customization.
      </p>
    </div>

    <!-- PRODUCTS GRID -->
    <div class="mt-20 grid grid-cols-1 gap-10 sm:grid-cols-2 md:grid-cols-3">
      {woodenBoxes.map((item) => (
        <a
          href={item.href}
          class="group block border border-[#efe6d6] bg-white"
        >
          <!-- IMAGE -->
          <div class="h-64 w-full overflow-hidden">
            <img
              src={item.image}
              alt={item.name}
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
          </div>

          <!-- NAME -->
          <div class="p-6 text-center">
            <p class="font-serif text-lg text-[#5c6442]">
              {item.name}
            </p>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>

</Layout>